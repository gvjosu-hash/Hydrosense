// Xolo — modelo de datos
// Multi-tenant: toda tabla operativa lleva tiendaId y toda query de la app
// debe filtrar por tiendaId (ver lib/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVenta {
  PIEZA
  GRANEL
}

enum Unidad {
  PIEZA
  KG
  G
  L
  ML
}

enum RolUsuario {
  DUENO
  EMPLEADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  FIADO
}

enum TipoTarjeta {
  CREDITO
  DEBITO
}

enum MetodoPagoAbono {
  EFECTIVO
  TARJETA
}

enum MotivoMerma {
  CADUCIDAD
  DANO
  ROBO
  OTRO
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  PAGO_FALLIDO
  CANCELADA
}

model Tienda {
  id        String   @id @default(cuid())
  nombre    String
  esDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  usuarios    Usuario[]
  productos   Producto[]
  ventas      Venta[]
  cortesCaja  CorteCaja[]
  clientes    Cliente[]
  abonos      Abono[]
  mermas      Merma[]
  suscripcion Suscripcion?

  @@map("tiendas")
}

model Usuario {
  id            String     @id @default(cuid())
  tiendaId      String
  tienda        Tienda     @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  correo        String?    @unique
  whatsapp      String?    @unique
  passwordHash  String
  nombre        String
  rol           RolUsuario @default(DUENO)
  createdAt     DateTime   @default(now())

  ventas Venta[]

  @@map("usuarios")
}

model Producto {
  id             String    @id @default(cuid())
  tiendaId       String
  tienda         Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  nombre         String
  tipoVenta      TipoVenta
  unidad         Unidad
  precio         Decimal   @db.Decimal(10, 2)
  // Costo de compra por unidad. Opcional: el catálogo precargado no lo trae,
  // se captura desde la edición del producto. Sin costo, los reportes de
  // utilidad tratan el costo como desconocido, no como cero.
  costo          Decimal?  @db.Decimal(10, 2)
  categoria      String?
  fechaCaducidad DateTime?
  stockActual    Decimal   @default(0) @db.Decimal(10, 3)
  stockMinimo    Decimal   @default(0) @db.Decimal(10, 3)
  codigoBarras   String?
  activo         Boolean   @default(true)
  orden          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ventaItems VentaItem[]
  mermas     Merma[]

  @@index([tiendaId])
  @@index([tiendaId, codigoBarras])
  @@map("productos")
}

model Venta {
  id             String     @id @default(cuid())
  tiendaId       String
  tienda         Tienda     @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario    @relation(fields: [usuarioId], references: [id])
  fecha          DateTime   @default(now())
  total          Decimal    @db.Decimal(10, 2)
  metodoPago     MetodoPago @default(EFECTIVO)
  // EFECTIVO: monto que dio el cliente. TARJETA: monto cobrado en la
  // terminal (normalmente igual al total).
  montoRecibido  Decimal?   @db.Decimal(10, 2)
  cambio         Decimal?   @db.Decimal(10, 2)
  // Solo cuando metodoPago = TARJETA: no procesamos el cobro (eso lo hace
  // la terminal física), solo registramos lo que ya imprimió el voucher.
  tipoTarjeta        TipoTarjeta?
  numeroAutorizacion String?
  // Solo cuando metodoPago = FIADO: a quién se le fió la venta.
  clienteId      String?
  cliente        Cliente?   @relation(fields: [clienteId], references: [id])
  // Idempotencia para sincronización offline (sección 9): id generado por el
  // cliente antes de tener conexión; único por tienda para evitar duplicados
  // al reintentar el envío.
  localId        String?

  items VentaItem[]

  @@unique([tiendaId, localId])
  @@index([tiendaId, fecha])
  @@index([clienteId])
  @@map("ventas")
}

// Cliente al que se le fía (cuentas por cobrar). El saldo pendiente no se
// guarda como columna: se calcula como suma de sus ventas FIADO menos la
// suma de sus abonos (ver lib/fiado.ts), para no arrastrar
// inconsistencias si algo falla a medio camino.
model Cliente {
  id        String   @id @default(cuid())
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  nombre    String
  whatsapp  String?
  createdAt DateTime @default(now())

  ventas Venta[]
  abonos Abono[]

  @@index([tiendaId])
  @@map("clientes")
}

model Abono {
  id        String          @id @default(cuid())
  tiendaId  String
  tienda    Tienda          @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  monto     Decimal         @db.Decimal(10, 2)
  metodoPago         MetodoPagoAbono @default(EFECTIVO)
  // Solo cuando metodoPago = TARJETA (misma lógica que en Venta: la
  // terminal física ya cobró, aquí solo se registra el voucher).
  tipoTarjeta        TipoTarjeta?
  numeroAutorizacion String?
  fecha     DateTime        @default(now())

  @@index([tiendaId, clienteId])
  @@map("abonos")
}

// Registro de pérdida de inventario (caducidad, daño, robo, etc.). Al
// crearse descuenta stockActual del producto, igual que una venta.
model Merma {
  id         String      @id @default(cuid())
  tiendaId   String
  tienda     Tienda      @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cantidad   Decimal     @db.Decimal(10, 3)
  motivo     MotivoMerma
  nota       String?
  fecha      DateTime    @default(now())

  @@index([tiendaId, fecha])
  @@map("mermas")
}

model VentaItem {
  id             String   @id @default(cuid())
  ventaId        String
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Decimal  @db.Decimal(10, 3)
  precioUnitario Decimal  @db.Decimal(10, 2)
  importe        Decimal  @db.Decimal(10, 2)

  @@map("venta_items")
}

model CorteCaja {
  id                  String   @id @default(cuid())
  tiendaId            String
  tienda              Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  fecha               DateTime @default(now())
  totalSistema        Decimal  @db.Decimal(10, 2)
  totalCapturado       Decimal  @db.Decimal(10, 2)
  diferencia          Decimal  @db.Decimal(10, 2)
  desglosePorMetodo   Json
  createdAt           DateTime @default(now())

  @@index([tiendaId, fecha])
  @@map("cortes_caja")
}

// Sección 7 (pendiente): se completa al conectar Mercado Pago.
model Suscripcion {
  id                  String            @id @default(cuid())
  tiendaId            String            @unique
  tienda              Tienda            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  mpPreapprovalId      String?
  estado              EstadoSuscripcion @default(PRUEBA)
  fechaInicioPrueba    DateTime          @default(now())
  fechaFinPrueba       DateTime?
  fechaProximoCobro    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("suscripciones")
}
